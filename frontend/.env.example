# Copy to .env.local (git-ignored) and adjust per machine.
# Leave VITE_EVENTS_URL unset in dev to use the Vite proxy (same origin, /ws/events).
# VITE_EVENTS_URL=ws://localhost:8000/ws/events
# VITE_TELEMETRY_STALE_MS=3000
# Map style. Unset = development-only online OpenStreetMap tiles (needs internet).
# For offline operation, point this at a locally served MapLibre style.json.
# VITE_MAP_STYLE_URL=http://localhost:8000/map/style.json
# Where the map opens before telemetry arrives ("lat,lon").
# VITE_MAP_CENTER=30.2291,-97.7555
