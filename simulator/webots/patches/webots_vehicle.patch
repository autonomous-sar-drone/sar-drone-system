+    def _offer_sar_frame(self):
+        # This method runs on the SAME thread that calls robot.step(). Never use
+        # Camera.getImage() from the publisher's background networking thread.
+        if self._sar_publisher is None:
+            return
+        sim_time_s = self.robot.getTime()
+        sample_s = self.camera.getSamplingPeriod() / 1000.0
+        last = self._sar_camera_last_capture_s
+        if last is not None and sim_time_s >= last and sim_time_s - last < sample_s - 1e-6:
+            return
+        raw = self.camera.getImage()
+        if raw is None:
+            return
+        self._sar_camera_last_capture_s = sim_time_s
+        self._sar_frame_number += 1
+        self._sar_publisher.offer(raw, self._sar_frame_number,
+                                  self.camera.getWidth(), self.camera.getHeight(),
